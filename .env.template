# Soundsave configuration.
# Copy this file to .env and fill in the values. Never commit .env.

# --- Yandex Music (sync) -----------------------------------------------------
# Personal access token: https://ym.marshal.dev/token
YANDEX_TOKEN=

# Full URL of the playlist to mirror.
PLAYLIST_URL=https://music.yandex.ru/users/USER/playlists/3

# Directory that contains the archive. Files are stored as
# "NNNN. Artist - Title.mp3".
TARGET_DIR=~/Music/Library

# Maximum number of new tracks downloaded per `soundsave sync` run.
MAX_DOWNLOADS=20

# --- Zvuk (audit / upgrade) --------------------------------------------------
# Token: log in at https://zvuk.com, open https://zvuk.com/api/tiny/profile
# and copy the "token" field. A paid subscription is required for 320 kbps
# MP3 and FLAC.
ZVUK_TOKEN=

# --- Matching and rate limiting (optional) -----------------------------------
# Minimum score for an automatic replacement (0..1).
SOUNDSAVE_MIN_SCORE=0.85

# Absolute duration tolerance in seconds; 2% of the track length is added.
SOUNDSAVE_DURATION_TOLERANCE=5

# Pause between network operations, in seconds.
SOUNDSAVE_DELAY=1.0
