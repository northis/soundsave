# Soundsave configuration.
# Copy this file to .env and fill in the values. Never commit .env.

# --- Yandex Music (sync) -----------------------------------------------------
# Personal access token: https://ym.marshal.dev/token
YANDEX_TOKEN=

# Full URL of the playlist to mirror.
PLAYLIST_URL=https://music.yandex.ru/users/USER/playlists/3

# Directory that contains the archive. Files are stored as
# "NNNN. Artist - Title.mp3". This is also the main playlist folder.
TARGET_DIR=~/Music/Library

# --- Web player ------------------------------------------------------------
# Root of the music library. Every immediate subfolder is a playlist; files
# inside a playlist folder are expected to be flat (no nested directories).
# For local CLI use. For Docker, point MUSIC_HOST_DIR below at the same folder.
MUSIC_DIR=~/Music
# The only playlist that gets the Yandex sync button.
MAIN_PLAYLIST=Library
# Web database and cover cache. Defaults to TARGET_DIR/.soundsave locally;
# docker-compose sets it to /app/data.
# DATA_DIR=~/Music/Library/.soundsave
# Host paths used by docker-compose. Docker Compose does not expand "~", so
# use an absolute path or a path relative to the repository root.
MUSIC_HOST_DIR=./music
DATA_HOST_DIR=./data
# Local development bind address and port. Docker publishes SOUNDSAVE_PORT.
SOUNDSAVE_HOST=127.0.0.1
SOUNDSAVE_PORT=8765
# Host interface and port published by docker-compose.
SOUNDSAVE_BIND_ADDR=0.0.0.0

# Maximum number of new tracks downloaded per `soundsave sync` run and per
# web sync button press. The web sync never uses Zvuk; if Yandex gives 192 kbps,
# that is what gets saved.
MAX_DOWNLOADS=20

# --- Zvuk (sync 320 kbps fallback / audit / upgrade) ------------------------
# Token: log in at https://zvuk.com, open https://zvuk.com/api/tiny/profile
# and copy the "token" field. A paid subscription is required for 320 kbps
# MP3 and FLAC.
ZVUK_TOKEN=

# --- Matching and rate limiting (optional) -----------------------------------
# Minimum score for an automatic replacement (0..1).
SOUNDSAVE_MIN_SCORE=0.85

# Absolute duration tolerance in seconds; 2% of the track length is added.
SOUNDSAVE_DURATION_TOLERANCE=5

# Pause between network operations, in seconds.
SOUNDSAVE_DELAY=1.0

# --- Discogs (optional; tags fallback) ---------------------------------------
# Personal access token: https://www.discogs.com/settings/developers
# Without a token Discogs is skipped; `--source discogs` requires a token.
DISCOGS_TOKEN=

# Minimum pause between Discogs API requests, in seconds. Discogs allows
# 60 requests/minute for authenticated users; 2.0 means 30 requests/minute.
DISCOGS_DELAY=2.0
